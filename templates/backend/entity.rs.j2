use sea_orm::entity::prelude::*;
use serde::Serialize;

#[derive(Clone, Debug, PartialEq, Eq, DeriveEntityModel, Serialize)]
#[sea_orm(table_name = "{{ table.name }}")]
pub struct Model {
    #[sea_orm(primary_key)]
    pub id: i64,
{%- for field in table.fields %}
{%- if field.text %}
