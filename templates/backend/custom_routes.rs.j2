//! Routes HTTP personnalisées, ajoutées à celles générées.

use axum::Router;
use forge_runtime::AppState;

/// Ajoutez vos routes ici, par exemple :
///
/// ```ignore
/// Router::new().route("/api/ping", axum::routing::get(|| async { "pong" }))
/// ```
///
/// Les handlers accèdent à la base via `State<AppState>` (`state.db()`).
pub fn routes() -> Router<AppState> {
    Router::new()
}
