# syntax=docker/dockerfile:1
{% if not web %}# check=skip=FromPlatformFlagConstDisallowed
{% endif %}# Image de {{ app_name }} : l'API sert aussi l'application web, sur le port 8080.
#
#   docker compose up --build          (voir docker-compose.yml)
#   docker build --build-context forge=<sources de forge> -t {{ app_name }} .
#
# Le projet dépend des sources de forge (forge-runtime, {% if web %}@forge/web{% else %}forge_flutter{% endif %}), passées
# comme contexte nommé `forge`.

ARG DEBIAN=trixie
ARG RUST_VERSION=1
{%- if not web %}
ARG FLUTTER_VERSION=3.47.6
{%- endif %}

# ------------------------------------------------------- application web
{%- if web %}
FROM node:22-slim AS web
COPY --from=forge packages/forge_web/package.json /forge/packages/forge_web/
COPY --from=forge packages/forge_web/src /forge/packages/forge_web/src
COPY scripts/use-forge.sh /src/scripts/
COPY web /src/web
RUN sh /src/scripts/use-forge.sh /forge
WORKDIR /src/web
RUN --mount=type=cache,target=/root/.npm \
    npm install --no-audit --no-fund && npm run build
{%- else %}
# Le SDK Flutter pour Linux n'existe qu'en x86-64 ; le résultat (JavaScript)
# ne dépend pas de la plateforme.
FROM --platform=linux/amd64 debian:${DEBIAN}-slim AS web
ARG FLUTTER_VERSION
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git unzip xz-utils \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
  | tar -xJ -C /opt \
 && git config --global --add safe.directory /opt/flutter
ENV PATH=/opt/flutter/bin:$PATH
COPY --from=forge packages/forge_flutter/pubspec.yaml packages/forge_flutter/analysis_options.yaml /forge/packages/forge_flutter/
COPY --from=forge packages/forge_flutter/lib /forge/packages/forge_flutter/lib
COPY scripts/use-forge.sh /src/scripts/
COPY app /src/app
RUN sh /src/scripts/use-forge.sh /forge
WORKDIR /src/app
RUN flutter pub get && flutter build web --release --no-web-resources-cdn
{%- endif %}

# ------------------------------------------------------------------- API
FROM rust:${RUST_VERSION}-slim-${DEBIAN} AS api
COPY --from=forge Cargo.toml Cargo.lock /forge/
COPY --from=forge crates /forge/crates
COPY scripts/use-forge.sh /src/scripts/
COPY backend /src/backend
RUN sh /src/scripts/use-forge.sh /forge
WORKDIR /src/backend
# Features supplémentaires, par exemple `forge-runtime/redis`.
ARG CARGO_FEATURES=""
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/backend/target \
    cargo build --release --features "$CARGO_FEATURES" \
 && cp target/release/{{ crate_name }} /usr/local/bin/{{ crate_name }}

# --------------------------------------------------------- image finale
FROM debian:${DEBIAN}-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --home-dir /data app \
 && mkdir /data && chown app /data
COPY --from=api /usr/local/bin/{{ crate_name }} /usr/local/bin/{{ crate_name }}
COPY --from=web {% if web %}/src/web/dist{% else %}/src/app/build/web{% endif %} /srv/web
USER app
WORKDIR /data
VOLUME /data
ENV FORGE_ADDR=0.0.0.0:8080 \
    FORGE_STATIC_DIR=/srv/web \
    FORGE_LOG_FORMAT=json \
    DATABASE_URL=sqlite:///data/data.db?mode=rwc
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=6s --start-period=20s CMD ["{{ crate_name }}", "health"]
ENTRYPOINT ["{{ crate_name }}"]
