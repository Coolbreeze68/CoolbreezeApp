# Copiez ce fichier en `.env` (jamais versionné) et renseignez les secrets.

# Signature des jetons de session : une longue chaîne aléatoire,
# par exemple `openssl rand -base64 48`.
FORGE_JWT_SECRET=

# Compte administrateur créé au premier démarrage (base sans utilisateur).
FORGE_ADMIN_EMAIL=admin@exemple.fr
FORGE_ADMIN_PASSWORD=

# Base PostgreSQL du conteneur `db`.
POSTGRES_PASSWORD=
POSTGRES_USER=forge
POSTGRES_DB={{ app_name }}

# Port publié sur la machine hôte.
PORT=8080

# Sources de forge (forge-runtime, forge_flutter), relatives à ce dossier.
FORGE_SOURCES={{ forge_path }}

# Cache Redis partagé : décommentez, puis `docker compose --profile redis up --build`.
# CARGO_FEATURES=forge-runtime/redis
# FORGE_CACHE_URL=redis://redis:6379
