name: {{ package_name }}
description: Application Flutter de {{ app_name }}, générée par forge.
publish_to: none
version: 0.1.0

environment:
  sdk: ^3.10.0

dependencies:
  decimal: ^3.2.6
  flutter:
    sdk: flutter
  forge_flutter:
    path: {{ package_path }}

dev_dependencies:
  flutter_lints: ^6.0.0
  flutter_test:
    sdk: flutter

flutter:
  uses-material-design: true
